<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZenitEngine.App</AssemblyName>
    <ApplicationIcon>Assets\zenit.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- Archivo by Omnibus-Type, SIL Open Font License (Assets/Fonts/OFL.txt). -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\zenit.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Builds ZenitEngine.exe next to the app; they talk through the Engine pipe and the CLI's JSON, not shared types. -->
    <ProjectReference Include="..\ZenitEngine\ZenitEngine.csproj" />
  </ItemGroup>
</Project>
